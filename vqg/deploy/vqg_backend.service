[Unit]
Description=VQG FastAPI Backend
After=network.target redis.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/vqg/vqg
EnvironmentFile=/home/ubuntu/vqg/vqg/.env
Environment="PATH=/home/ubuntu/vqg/vqg/venv/bin"
ExecStart=/home/ubuntu/vqg/vqg/venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
